# Prisma Database URL for SQLite
DATABASE_URL="file:./prisma/dev.db"

# Auth.js Secret
# Generate a strong secret using: `openssl rand -base64 32`
AUTH_SECRET="your-super-secret-key-here"
AUTH_TRUST_HOST=true

# OAuth Provider Credentials
# --- GitHub ---
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# --- Google ---
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# --- Facebook ---
AUTH_FACEBOOK_ID="your-facebook-app-id"
AUTH_FACEBOOK_SECRET="your-facebook-app-secret"

# Email Provider (for passwordless magic links)
# Example using a generic SMTP server
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="your-email-username"
EMAIL_SERVER_PASSWORD="your-email-password"
EMAIL_FROM="no-reply@eduvibe.com"

# For production, use a service like Resend:
# EMAIL_SERVER_HOST="smtp.resend.com"
# EMAIL_SERVER_PORT="587"
# EMAIL_SERVER_USER="resend"
# EMAIL_SERVER_PASSWORD="your-resend-api-key"
# EMAIL_FROM="no-reply@yourdomain.com"
