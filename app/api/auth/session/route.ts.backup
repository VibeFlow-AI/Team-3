import { auth } from "@/auth"
import { NextResponse } from "next/server"

/**
 * GET /api/auth/session
 * 
 * DEPRECATED: Use /api/auth/unified-session instead.
 * This endpoint is kept for backward compatibility.
 * 
 * @returns {Response} JSON response containing:
 *   - If authenticated: { user: { id, name, email, role, image } }
 *   - If not authenticated: null
 */
export async function GET() {
  try {
    // Use Auth.js helper to get the current session
    const session = await auth()
    
    // If no session exists or user is not authenticated, return null
    if (!session || !session.user) {
      return NextResponse.json(null, { status: 200 })
    }

    // Return the user data from the session with deprecation warning
    return NextResponse.json({ 
      user: session.user,
      _deprecated: {
        message: "This endpoint is deprecated. Use /api/auth/unified-session instead.",
        newEndpoint: "/api/auth/unified-session"
      }
    }, { status: 200 })
    
  } catch (error) {
    console.error("Error fetching session:", error)
    return NextResponse.json(
      { error: "Failed to retrieve session" }, 
      { status: 500 }
    )
  }
}
